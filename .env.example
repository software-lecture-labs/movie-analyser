# Copy this file to .env and set your own values. Never commit .env.
# Docker Compose reads it automatically; the application reads the same
# values from environment variables.

DB_HOST=localhost
DB_PORT=27017
DB_NAME=movieanalyser
DB_USER=movieanalyser
# Replace change-me with your own password. Use letters and digits only:
# the password is embedded in the connection URI (jnosql.mongodb.url), so
# characters like @ : / ? # % break the URI and cause "authentication failed".
DB_PASSWORD=change-me

# Entegrasyon testlerinin kullanıcısı; yalnızca test veritabanında (DB_NAME + _test) yetkilidir.
# Sunucu ortamında boş bırakılırsa bu kullanıcı hiç oluşturulmaz. Şifrede yine yalnızca harf ve rakam.
DB_TEST_USER=movieanalyser_test
DB_TEST_PASSWORD=change-me-test

# Only used by the MongoDB container (admin account)
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change-me-root
