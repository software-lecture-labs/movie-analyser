# Copy this file to .env and set your own values. Never commit .env.
# Docker Compose reads it automatically; the application reads the same
# values from environment variables.

DB_HOST=localhost
DB_PORT=27017
DB_NAME=movieanalyser
DB_USER=movieanalyser
DB_PASSWORD=change-me

# Only used by the MongoDB container (admin account)
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change-me-root
