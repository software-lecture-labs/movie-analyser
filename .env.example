# Bu dosyayı .env adıyla kopyalayın ve kendi değerlerinizi girin. .env asla commit'lenmez.
# Docker Compose bu dosyayı otomatik okur; uygulama da aynı değerleri
# ortam değişkenlerinden okur.

DB_HOST=localhost
DB_PORT=27017
DB_NAME=movieanalyser
DB_USER=movieanalyser
# change-me yerine kendi şifrenizi yazın. Yalnızca harf ve rakam kullanın:
# şifre bağlantı URI'sinin (jnosql.mongodb.url) içine gömülür; bu yüzden
# @ : / ? # % gibi karakterler URI'yi bozar ve "authentication failed" hatasına yol açar.
DB_PASSWORD=change-me

# Entegrasyon testlerinin kullanıcısı; yalnızca test veritabanında (DB_NAME + _test) yetkilidir.
# Sunucu ortamında boş bırakılırsa bu kullanıcı hiç oluşturulmaz. Şifrede yine yalnızca harf ve rakam.
DB_TEST_USER=movieanalyser_test
DB_TEST_PASSWORD=change-me-test

# Yalnızca MongoDB konteyneri tarafından kullanılır (yönetici hesabı)
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change-me-root
