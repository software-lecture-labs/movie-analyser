# Shared editor settings for every IDE on Windows and macOS
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,xml}]
indent_size = 2

# Markdown uses trailing spaces for line breaks
[*.md]
trim_trailing_whitespace = false

# Windows-only scripts keep CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf
