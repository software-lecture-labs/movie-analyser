# Windows ve macOS üzerindeki tüm IDE'ler için ortak editör ayarları
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,xml}]
indent_size = 2

# Markdown satır sonu için sondaki boşlukları kullanır
[*.md]
trim_trailing_whitespace = false

# Yalnızca Windows'a özgü betikler CRLF olarak kalır
[*.{bat,cmd,ps1}]
end_of_line = crlf
